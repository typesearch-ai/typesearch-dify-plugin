# Remote debugging: run the plugin from your machine against a Dify instance.
# In Dify, open Plugins and click the debug (bug) icon: it shows the URL and the key to paste here.
# Copy this file to .env (never commit .env) and run: uv run python -m main
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug-plugin.dify.dev:5003
REMOTE_INSTALL_KEY=********-****-****-****-************
